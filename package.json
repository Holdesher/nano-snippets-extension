	"homepage": "https://github.com/holdesher/nano-snippets/blob/main/README.md",
	"pricing": "Free",
	"qna": false,
	"devDependencies": {
		"@vscode/vsce": "^4.0.0",
		"dotenv-cli": "^8.0.0",
		"ovsx": "^0.10.7"
	},
	"scripts": {
		"build": "vsce package",
		"clear": "rm -rf *.vsix",
		"ovsx:namespace": "dotenv -e .env -- sh -c 'ovsx create-namespace kah3vich -p \"$OVSX_TOKEN\"'",
		"ovsx:publish": "dotenv -e .env -- sh -c 'ovsx publish nanosnippets-0.0.40.vsix -p \"$OVSX_TOKEN\"'",
		"ovsx:publish:build": "npm run build && npm run ovsx:publish",
		"prepare": "husky"
	}
}
