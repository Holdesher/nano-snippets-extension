{
	"GLSL: Noise 2D": {
		"prefix": "noise",
		"body": [
			"float hash21(vec2 p) {",
			"\tp = fract(p * vec2(123.34, 456.21));",
			"\tp += dot(p, p + 45.32);",
			"\treturn fract(p.x * p.y);",
			"}",
			"",
			"float noise(vec2 p) {",
			"\tvec2 i = floor(p);",
			"\tvec2 f = fract(p);",
			"\tf = f * f * (3.0 - 2.0 * f);",
			"",
			"\treturn mix(",
			"\t\tmix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x),",
			"\t\tmix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0)), f.x),",
			"\t\tf.y",
			"\t);",
			"}",
			"$0"
		],
		"description": "GLSL: 2D Value Noise with Hash Dependency"
	}
}
